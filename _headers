# Cloudflare Pages header rules.
# The repo root is the deploy output directory, so this file ships as-is.

# Baseline security headers for every response.
#
# Deliberately NOT set here: Content-Security-Policy. The donate page loads the
# PayPal SDK, which pulls in further PayPal origins and injects inline script
# and frames, so a policy written without testing against a real donation would
# risk silently breaking the checkout. Worth adding, but it needs to be trialled
# in Report-Only mode against a live payment first.
/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  # payment= is intentionally left unrestricted: the PayPal SDK may use the
  # Payment Request API, and blocking it here could break donations.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Images are content-hashed by the build, exactly like the CSS and JS, so every
# referenced image URL changes when its bytes change and can be cached
# permanently. This replaced a one-day max-age on stable filenames, which meant
# a replaced photo was served stale from some Cloudflare edge nodes and fresh
# from others, so the same visitor could see either. The unhashed originals stay
# in the repo as the editable sources and are not referenced by any page.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed assets. The filename changes whenever the bytes change,
# so these can be cached permanently and never revalidated. This is what
# makes a deploy take effect instantly instead of waiting out a TTL.
/css/style.*.css
  Cache-Control: public, max-age=31536000, immutable

/css/refinements.*.css
  Cache-Control: public, max-age=31536000, immutable

/js/script.*.js
  Cache-Control: public, max-age=31536000, immutable

# The unhashed sources stay in the repo as the editable originals and are
# not referenced by any page. Keep them short-lived in case anything
# reaches them directly.
/css/style.css
  Cache-Control: public, max-age=300

/css/refinements.css
  Cache-Control: public, max-age=300

/js/script.js
  Cache-Control: public, max-age=300
